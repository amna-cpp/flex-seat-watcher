{
  "manifest_version": 3,
  "name": "Flex Seat Watcher",
  "version": "1.5.2",
  "description": "Watch selected Flex course rows and notify when registration becomes available.",
  "permissions": [
    "alarms",
    "debugger",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://flexstudent.nu.edu.pk/*",
    "https://*.nu.edu.pk/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flex Seat Watcher"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*",
        "https://*.nu.edu.pk/*"
      ],
      "js": [
        "scanner.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
